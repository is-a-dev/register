# Public URL used in generated patient links
PUBLIC_URL=https://dripacs.is-a.dev

# Generate strong random values; never commit the real values
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# Fixed/common patient-link password for all studies
LINK_PASSWORD=replace-with-your-common-patient-password

# Password hash for the admin account (Werkzeug format)
ADMIN_PASSWORD_HASH=replace-with-a-generated-password-hash

DICOM_AE_TITLE=SECURELINK
DICOM_PORT=11112
PORT=5000
DRIPACS_DB=secure_links.db
