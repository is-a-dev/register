};
addEventListener("keydown",e=>{
 if(["INPUT","TEXTAREA"].includes(document.activeElement.tagName))return;
 if(e.code==="Space"){e.preventDefault();spawn();}
 if(e.key.toLowerCase()==="b")boom();
 if(e.key.toLowerCase()==="r")spawnRain(5);
 if(e.key.toLowerCase()==="c")clearWorld();
});

/* A few starter objects, rather than filling the page immediately. */
for(let i=0;i<3;i++){
 spawn("random",rand(60,Math.max(100,W-60)),rand(100,Math.max(140,H-180)));
}
