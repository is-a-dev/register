  "cache": {
    "ttl": {
      "browser": 14400,
      "edge": 86400
    },
    "always_online": true
  },

  "firewall": {
    "security_level": "medium",
    "challenge_ttl": 1800,
    "bot_fight_mode": true
  },

  "page_rules": [
    {
      "match": "*/*",
      "settings": {
        "cache_level": "cache_everything",
        "edge_cache_ttl": 86400
      }
    },
    {
      "match": "*/admin*",
      "settings": {
        "security_level": "high"
      }
    }
  ]
