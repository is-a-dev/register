        "value": "ebd90925cdd2af3278b6f3992a5ac4"
      },
      {
        "name": "_domainconnect",
        "value": "disabled"
      }
    ],

    "CAA": [
      { "flags": 0, "tag": "issue", "value": "letsencrypt.org" },
      { "flags": 0, "tag": "issue", "value": "pki.goog" },
      { "flags": 0, "tag": "issuewild", "value": ";" },
      { "flags": 0, "tag": "iodef", "value": "mailto:zurai02ispro@gmail.com" }
    ],

    "SRV": [],

    "NS": null
  },

  "security": {
    "dnssec": true,
    "tls": {
      "min_version": "1.2",
      "hsts": {
        "enabled": true,
        "max_age": 31536000,
        "include_subdomains": true,
        "preload": true
      }
    },
    "https": {
      "redirect": true,
      "auto_https": true
    }
  },

  "monitoring": {
    "health_checks": {
      "enabled": true,
      "interval": 300,
      "timeout": 10,
      "retries": 2
