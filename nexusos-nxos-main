            audioPlayer.pause();
            audioPlayer.src = '';
            audioPrompt.classList.remove('hidden');
            audioPreviewContainer.classList.add('hidden');
            audioActionControls.classList.add('hidden');
            voiceResultBox.classList.add('hidden');
        }
    </script>
</body>
</html>
